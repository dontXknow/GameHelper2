<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeRoot Condition="'$(RuntimeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\GameHelper\bin\Release\net10.0-windows\win-x64</RuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="$(RuntimeRoot)\Newtonsoft.Json.dll" />
    <Reference Include="GameOffsets" HintPath="$(RuntimeRoot)\GameOffsets.dll" />
  </ItemGroup>
</Project>
